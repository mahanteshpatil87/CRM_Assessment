<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="CRM_Assessment_Smoke_Suite" verbose="1">
    <listeners>
        <listener class-name="com.crmassessment.listeners.TestNGListener"/>
    </listeners>

    <!-- Critical-path only: login, dashboard access, one basic employee
         operation, logout. Run this on every change before regression. -->
    <test name="SmokeTests">
        <classes>
            <class name="com.crmassessment.tests.admin.AdminLoginTests"/>
            <class name="com.crmassessment.tests.pim.AddEmployeeTests">
                <methods>
                    <include name="addEmployeeWithMandatoryFieldsSucceeds"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
